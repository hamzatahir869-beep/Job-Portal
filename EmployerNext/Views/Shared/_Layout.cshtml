<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployerNext</title>
    <link rel="icon" type="image/png" href="~/assets/images/favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="clp-navbar">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-6 col-lg-3">
                        <a href="/">
                                <img src="~/assets/images/site-logo.png" alt="Site Logo" class="nav-img" />
                        </a>
                    </div>
                    <div class="col-lg-7 d-none d-lg-block">
                        <ul class="clp-nav-links justify-content-center">
                            <li><a class="clp-nav-link">Services</a></li>
                            <li><a class="clp-nav-link">Resume Samples</a></li>
                            <li><a class="clp-nav-link">Pricing</a></li>
                            <li><a class="clp-nav-link">About Us</a></li>
                            <li><a class="clp-nav-link">Resources</a></li>
                            <li><a class="clp-nav-link">FAQs</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-lg-2 text-end">
                        <button class="clp-cta-btn clp-desktop-cta d-none d-lg-inline-block">
                            Get Profile Review
                        </button>
                        <button class="navbar-toggler d-lg-none border-0 shadow-none p-1"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#clpMobileMenu"
                                aria-controls="clpMobileMenu"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                            <i class="fas fa-bars text-dark fs-5"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="collapse clp-mobile-menu" id="clpMobileMenu">
                <div class="container">
                    <ul class="mb-0">
                        <li><a href="#" class="clp-nav-link">Services</a></li>
                        <li><a href="#" class="clp-nav-link">Resume Samples</a></li>
                        <li><a href="#" class="clp-nav-link">Pricing</a></li>
                        <li><a href="#" class="clp-nav-link">About Us</a></li>
                        <li><a href="#" class="clp-nav-link">Resources</a></li>
                        <li><a href="#" class="clp-nav-link">FAQs</a></li>
                    </ul>
                    <div class="mt-3">
                        <button class="clp-cta-btn w-100">Get My Resume</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
       
        <main role="main" >
            @RenderBody()
        </main>

    <footer class="clf-footer">
        <div class="container">
            <div class="clf-footer__top">
                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div class="clp-brand">
                                <img src="./assets/images/site-footer-logo.png" alt="" />
                            </div>
                        </div>
                        <p class="clf-brand-desc">
                            Helping professionals stand out, get noticed, and get hired.
                        </p>

                        <a href="tel:+866-656-9514" class="clf-phone">
                            <i class="fas fa-phone-alt me-2"></i>+1 (866) 656-9514
                        </a>
                        <a href="mailto:care@employernext.com" class="clf-phone">
                            <i class="fas fa-envelope me-2"></i>care@employernext.com
                        </a>


                        <div class="clf-socials">
                            <a href="#" class="clf-social-btn">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="https://www.facebook.com/employernext" target="_blank" class="clf-social-btn">
                                <i class="fab fa-facebook-f"></i>
                            </a>

                        </div>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <span class="clf-col-title">Services</span>
                        <ul class="clf-nav-list">
                            <li><a href="#">Resume Writing</a></li>
                            <li><a href="#">LinkedIn Writing</a></li>
                            <li><a href="#">Cover Letters</a></li>
                            <li><a href="#">Executive Bios</a></li>
                            <li><a href="#">Career Change Resumes</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <span class="clf-col-title">Company</span>
                        <ul class="clf-nav-list">
                            <li><a href="#">About Us</a></li>
                            <li><a href="#">Resume Samples</a></li>
                            <li><a href="#">Reviews</a></li>
                            <li><a href="#">Resources</a></li>
                            <li><a href="#">Contact Us</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <span class="clf-col-title">Support</span>
                        <ul class="clf-nav-list">
                            <li><a href="#">FAQs</a></li>
                            <li><a href="#">How It Works</a></li>
                            <li><a href="@Url.Action("Privacy", "Home")">Privacy Policy</a></li>
                            @* <li><a href="#">Terms of Service</a></li> *@

                        </ul>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="clf-cta-box">
                            <p class="clf-cta-box__title">
                                Ready to get interviews globally?
                            </p>
                            <p class="clf-cta-box__desc">
                                Start your international job search with a proven distribution
                                system.
                            </p>
                            <a href="#free-review" class="clf-cta-btn">
                                <i class="fas fa-arrow-right me-2"></i>Get Started Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clf-footer__bottom">
                <div class="row align-items-center">
                    <div class="col-12 col-md-6">
                        <p class="clf-copyright">
                            &copy; <span id="clf-year"></span> EmployerNext. All rights reserved.
                        </p>
                    </div>
                    <div class="col-12 col-md-6 text-md-end">
                        <p class="clf-tagline">
                            Built with care for your career success.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

 
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/script/script.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('clf-year').textContent = new Date().getFullYear();


        /* ── Mobile Menu Manual Toggle ── */
        var toggler = document.querySelector('.navbar-toggler');
        var mobileMenu = document.getElementById('clpMobileMenu');

        if (toggler && mobileMenu) {
        // Bootstrap ka data-bs-toggle remove karo JS se
        toggler.removeAttribute('data-bs-toggle');
        toggler.removeAttribute('data-bs-target');

        toggler.addEventListener('click', function () {
        var isOpen = mobileMenu.classList.contains('open');

        if (isOpen) {
        mobileMenu.classList.remove('open');
        toggler.querySelector('i').classList.replace('fa-xmark', 'fa-bars');
        } else {
        mobileMenu.classList.add('open');
        toggler.querySelector('i').classList.replace('fa-bars', 'fa-xmark');
        }
        });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
