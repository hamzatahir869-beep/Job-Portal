    <section class="frr-section" id="free-review">
        <div class="container">
            <div class="frr-card">
                <div class="row g-0 align-items-center">
                    <!-- LEFT -->
                    <div class="col-12 col-lg-4 frr-left-col pe-lg-4">
                        <div class="frr-badge">
                            <i class="fas fa-shield-halved"></i>
                            Free Global Job Search Review
                        </div>

                        <h2 class="frr-heading">
                            Get a free global job search review from our experts
                        </h2>
                        <p class="frr-subtext">
                            Upload your resume and get actionable insights to land
                            interviews internationally.
                        </p>
                        <div class="d-flex gap-4 align-items-start">
                            <ul class="frr-checklist">
                                <li>
                                    <span class="frr-check-icon">
                                        <i class="fas fa-check"></i>
                                    </span>
                                    ATS &amp; keyword analysis
                                </li>
                                <li>
                                    <span class="frr-check-icon">
                                        <i class="fas fa-check"></i>
                                    </span>
                                    Market fit evaluation
                                </li>
                                <li>
                                    <span class="frr-check-icon">
                                        <i class="fas fa-check"></i>
                                    </span>
                                    Outreach improvement tips
                                </li>
                            </ul>
                            <div class="frr-illustration">
                                <div class="frr-illus-doc" style="position: relative">
                                    <div class="frr-illus-avatar"></div>
                                    <div class="frr-illus-line frr-short"></div>
                                    <div class="frr-illus-line frr-full"></div>
                                    <div class="frr-illus-line frr-med"></div>
                                    <div class="frr-illus-line frr-full"></div>
                                    <div class="frr-illus-line frr-short"></div>
                                    <div class="frr-illus-badge">
                                        <i class="fas fa-magnifying-glass-check"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VERTICAL DIVIDER -->
                    <div class="d-none d-lg-block frr-divider align-self-stretch"></div>

                    <!-- RIGHT — FORM -->
                    <div class="col-12 col-lg ps-lg-4">
                    <div id="successMessage" class="alert alert-success d-none"></div>
                        <form id="reviewForm" asp-action="SubmitReview" asp-controller="Home" method="post" enctype="multipart/form-data">
                            @if (ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                            {
                                <div class="alert alert-danger">
                                    @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                                    {
                                        <p>@error.ErrorMessage</p>
                                    }
                                </div>
                            }
                        @if (TempData["Success"] != null)
                        {
                            <script>
                                window.onload = function () {
                                    document.getElementById("free-review")
                                        .scrollIntoView({ behavior: "auto", block: "start" });
                                };
                            </script>
                        }
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <label class="frr-form-label">Full Name</label>
                                    <input type="text"
                                           name="FullName"
                                           class="frr-input"
                                           placeholder="Your full name" />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="frr-form-label">Email Address</label>
                                    <input type="email"
                                           name="Email"
                                           class="frr-input"
                                           placeholder="you@example.com" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <label class="frr-form-label">Phone Number</label>
                                    <input type="tel"
                                           name="PhoneNumber"
                                           class="frr-input"
                                           placeholder="(123) 456-7890" />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="frr-form-label">Current Job Title</label>
                                    <input type="text"
                                           name="CurrentJobTitle"
                                           class="frr-input"
                                           placeholder="e.g. Marketing Manager" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="frr-form-label">Upload Your Resume</label>
                                <div class="frr-upload-zone"
                                     onclick="document.getElementById('frrFileInput').click()">
                                    <div class="frr-upload-left">
                                        <div class="frr-upload-icon">
                                            <i class="fas fa-cloud-arrow-up"></i>
                                        </div>
                                        <div>
                                            <span class="frr-upload-text">Click to upload or drag and drop</span>
                                            <span class="frr-upload-hint">PDF, DOC, DOCX (Max 5MB)</span>
                                        </div>
                                    </div>
                                    <i class="fas fa-arrow-up-from-bracket frr-upload-arrow"></i>
                                </div>
                                <input type="file"
                                       name="Resume"
                                       id="frrFileInput"
                                       accept=".pdf,.doc,.docx"
                                       style="display: none" />
                            </div>

                            <button type="submit"  class="frr-submit-btn">
                                Get My Free Review
                            </button>
                            <p class="frr-privacy">
                                We respect your privacy. Your information is safe with us.
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
@section scripts {
    <script src="~/js/LeadForm.js"></script>
}


