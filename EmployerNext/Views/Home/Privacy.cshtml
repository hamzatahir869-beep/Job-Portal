@{
    ViewData["Title"] = "Privacy Policy";
}

    <section class="pvp-page">
        <!-- Hero -->
        <div class="pvp-hero">
            <div class="pvp-hero-badge">
                <i class="fa-solid fa-shield-halved"></i> Legal &amp; Compliance
            </div>
            <h1>Privacy Policy</h1>
            <div class="pvp-hero-meta">
                <span>
                    <i class="fa-regular fa-calendar"></i> Effective: April 28,
                    2026
                </span>
                <span>
                    <i class="fa-regular fa-clock"></i> Last Updated: April 28,
                    2026
                </span>
                <span><i class="fa-solid fa-book-open"></i> 10 min read</span>
            </div>
        </div>

        <!-- Layout: TOC + Content -->
        <div class="pvp-layout">
            <!-- Sidebar TOC -->
            <aside class="pvp-toc">
                <div class="pvp-toc-heading">
                    <i class="fa-solid fa-list"></i> Table of Contents
                </div>
                <ul class="pvp-toc-list">
                    <li>
                        <a href="#pvp-s1" class="pvp-toc-active"><i class="fa-solid fa-circle-info"></i> Overview</a>
                    </li>
                    <li>
                        <a href="#pvp-s2"><i class="fa-solid fa-database"></i> Information We Collect</a>
                    </li>
                    <li>
                        <a href="#pvp-s3"><i class="fa-solid fa-gears"></i> How We Use Your Info</a>
                    </li>
                    <li>
                        <a href="#pvp-s4"><i class="fa-solid fa-share-nodes"></i> Information Sharing</a>
                    </li>
                    <li>
                        <a href="#pvp-s5">
                            <i class="fa-solid fa-cookie-bite"></i> Cookies &amp;
                            Tracking
                        </a>
                    </li>
                    <li>
                        <a href="#pvp-s6"><i class="fa-solid fa-lock"></i> Data Security</a>
                    </li>
                    <li>
                        <a href="#pvp-s7"><i class="fa-solid fa-user-shield"></i> Your Rights</a>
                    </li>
                    <li>
                        <a href="#pvp-s8"><i class="fa-solid fa-child"></i> Children's Privacy</a>
                    </li>
                    <li>
                        <a href="#pvp-s9"><i class="fa-solid fa-globe"></i> Third-Party Links</a>
                    </li>
                    <li>
                        <a href="#pvp-s10"><i class="fa-solid fa-rotate"></i> Policy Changes</a>
                    </li>
                    <li>
                        <a href="#pvp-s11"><i class="fa-solid fa-envelope"></i> Contact Us</a>
                    </li>
                </ul>
                <div class="pvp-toc-divider"></div>
                <div class="pvp-toc-note">
                    <p>Questions about your privacy?</p>
                <a href="mailto:care@employernext.com">
                        <i class="fa-regular fa-envelope"></i> Email our team
                    </a>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="pvp-content">
                <div class="pvp-intro-alert">
                    <i class="fa-solid fa-circle-info"></i>
                    <p>
                        At EmployerNext, your privacy is fundamental to how we
                        operate. This policy explains exactly what data we collect, why we
                        collect it, and how you can control it. We never sell your
                        personal information to third parties.
                    </p>
                </div>

                <!-- 1. Overview -->
                <div class="pvp-section" id="pvp-s1">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">1</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-circle-info"></i>
                        </div>
                        <h2>Overview</h2>
                    </div>
                    <p>
                    EmployerNext ("we," "us," or "our") operates the website
                    employernext.com and provides professional resume writing
                        services. This Privacy Policy describes how we collect, use,
                        disclose, and safeguard your information when you visit our
                        website or use our services.
                    </p>
                    <p>
                        By using our Services, you agree to the collection and use of
                        information in accordance with this policy. If you do not agree,
                        please discontinue use of our website and services.
                    </p>
                    <div class="pvp-box-green">
                        <i class="fa-solid fa-circle-check"></i>
                        <p>
                            We are committed to transparency. This policy is written in
                            plain language to ensure you fully understand your rights and
                            our obligations regarding your personal data.
                        </p>
                    </div>
                </div>

                <!-- 2. Information We Collect -->
                <div class="pvp-section" id="pvp-s2">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">2</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-database"></i>
                        </div>
                        <h2>Information We Collect</h2>
                    </div>
                    <p>
                        We collect information you provide directly to us and information
                        gathered automatically when you use our services.
                    </p>
                    <p><strong>Information You Provide</strong></p>
                    <ul class="pvp-list">
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Full name, email
                            address, phone number, and billing information when placing an
                            order
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Resume documents, work
                            history, educational background, and career goals you submit
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Communications sent
                            via email, contact forms, or live chat
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Account credentials if
                            you create a user account on our platform
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Feedback, reviews, or
                            survey responses you voluntarily submit
                        </li>
                    </ul>
                    <p><strong>Information Collected Automatically</strong></p>
                    <ul class="pvp-list">
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Log data: IP address,
                            browser type, pages visited, and time spent
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Device information:
                            hardware model, operating system, and unique device identifiers
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Usage analytics
                            through cookies and similar tracking technologies
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Referral source data
                            to understand how you discovered our services
                        </li>
                    </ul>
                </div>

                <!-- 3. How We Use -->
                <div class="pvp-section" id="pvp-s3">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">3</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-gears"></i>
                        </div>
                        <h2>How We Use Your Information</h2>
                    </div>
                    <p>We use the information we collect for the following purposes:</p>
                    <ul class="pvp-list">
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Service Delivery:</strong> To create and deliver your
                            resume, cover letter, LinkedIn profile, and other career
                            documents
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Order Processing:</strong> To process payments, send
                            order confirmations, and manage your account
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Communication:</strong> To respond to inquiries, send
                            service updates, and provide customer support
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Marketing:</strong> To send promotional emails and
                            offers (you may opt out at any time)
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Analytics:</strong> To understand how our website and
                            services are used and improve them
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Legal Compliance:</strong> To comply with applicable
                            laws, regulations, and legal processes
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Fraud Prevention:</strong> To detect, investigate, and
                            prevent fraudulent transactions and abuse
                        </li>
                    </ul>
                </div>

                <!-- 4. Sharing -->
                <div class="pvp-section" id="pvp-s4">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">4</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-share-nodes"></i>
                        </div>
                        <h2>Information Sharing &amp; Disclosure</h2>
                    </div>
                    <p>
                        We do not sell, trade, or rent your personal information to third
                        parties. We may share your information only in these limited
                        circumstances:
                    </p>
                    <ul class="pvp-list">
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Service Providers:</strong> Trusted vendors who assist
                            in operating our website and delivering services (payment
                            processors, cloud hosting, email delivery) — all bound
                            contractually to protect your data
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Professional Writers:</strong> Our certified resume
                            writers receive your career documents to perform requested
                            services and are bound by confidentiality agreements
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Legal Requirements:</strong> When required by law, court
                            order, or governmental authority
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Business Transfers:</strong> In connection with a
                            merger, acquisition, or sale of assets, with prior notice to you
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>With Your Consent:</strong> For any other purpose with
                            your explicit consent
                        </li>
                    </ul>
                    <div class="pvp-box-green">
                        <i class="fa-solid fa-circle-check"></i>
                        <p>
                            We will never sell your resume, personal data, or career
                            information to employers, recruiters, or advertising networks.
                        </p>
                    </div>
                </div>

                <!-- 5. Cookies -->
                <div class="pvp-section" id="pvp-s5">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">5</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-cookie-bite"></i>
                        </div>
                        <h2>Cookies &amp; Tracking Technologies</h2>
                    </div>
                    <p>
                        We use cookies and similar tracking technologies to enhance your
                        experience. Cookies are small data files stored on your device.
                    </p>
                    <ul class="pvp-list">
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Essential Cookies:</strong> Required for the website to
                            function (login sessions, cart data). These cannot be disabled.
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Analytics Cookies:</strong> Help us understand how
                            visitors interact with our site (Google Analytics). You may opt
                            out via browser settings.
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>Marketing Cookies:</strong> Used to serve relevant
                            advertisements. Disable via our cookie preference center.
                        </li>
                    </ul>
                    <div class="pvp-box-amber">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <p>
                            You can control cookies through your browser settings. Disabling
                            essential cookies may affect website functionality. For Google
                            Analytics opt-out, visit
                            <strong>tools.google.com/dlpage/gaoptout</strong>.
                        </p>
                    </div>
                </div>

                <!-- 6. Security -->
                <div class="pvp-section" id="pvp-s6">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">6</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <h2>Data Security</h2>
                    </div>
                    <p>
                        We implement industry-standard security measures to protect your
                        personal information from unauthorized access, alteration,
                        disclosure, or destruction.
                    </p>
                    <ul class="pvp-list">
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> SSL/TLS encryption for
                            all data transmitted between your browser and our servers
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Encrypted storage for
                            sensitive documents and personal information
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Regular security
                            audits and vulnerability assessments
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Strict access controls
                            — only authorized personnel can access your data
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Secure payment
                            processing via PCI-DSS compliant providers
                        </li>
                    </ul>
                    <div class="pvp-box-amber">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <p>
                            No method of electronic transmission is 100% secure. While we
                            strive to protect your data, we cannot guarantee absolute
                            security. In the event of a data breach, we will notify affected
                            users as required by law.
                        </p>
                    </div>
                </div>

                <!-- 7. Your Rights -->
                <div class="pvp-section" id="pvp-s7">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">7</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <h2>Your Rights &amp; Choices</h2>
                    </div>
                    <p>
                        Depending on your location, you may have the following rights
                        regarding your personal information:
                    </p>
                    <div class="pvp-rights-grid">
                        <div class="pvp-right-card">
                            <div class="pvp-right-icon">
                                <i class="fa-solid fa-eye"></i>
                            </div>
                            <div>
                                <div class="pvp-right-title">Right to Access</div>
                                <p class="pvp-right-desc">
                                    Request a copy of the personal data we hold about you.
                                </p>
                            </div>
                        </div>
                        <div class="pvp-right-card">
                            <div class="pvp-right-icon">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </div>
                            <div>
                                <div class="pvp-right-title">Right to Correct</div>
                                <p class="pvp-right-desc">
                                    Request correction of inaccurate or incomplete data.
                                </p>
                            </div>
                        </div>
                        <div class="pvp-right-card">
                            <div class="pvp-right-icon">
                                <i class="fa-solid fa-trash-can"></i>
                            </div>
                            <div>
                                <div class="pvp-right-title">Right to Delete</div>
                                <p class="pvp-right-desc">
                                    Request deletion of your personal data, subject to legal
                                    requirements.
                                </p>
                            </div>
                        </div>
                        <div class="pvp-right-card">
                            <div class="pvp-right-icon">
                                <i class="fa-solid fa-hand"></i>
                            </div>
                            <div>
                                <div class="pvp-right-title">Right to Object</div>
                                <p class="pvp-right-desc">
                                    Object to processing of your data for marketing purposes.
                                </p>
                            </div>
                        </div>
                        <div class="pvp-right-card">
                            <div class="pvp-right-icon">
                                <i class="fa-solid fa-file-export"></i>
                            </div>
                            <div>
                                <div class="pvp-right-title">Data Portability</div>
                                <p class="pvp-right-desc">
                                    Receive your data in a structured, machine-readable format.
                                </p>
                            </div>
                        </div>
                        <div class="pvp-right-card">
                            <div class="pvp-right-icon">
                                <i class="fa-solid fa-ban"></i>
                            </div>
                            <div>
                                <div class="pvp-right-title">Right to Restrict</div>
                                <p class="pvp-right-desc">
                                    Request that we limit how we process your personal data.
                                </p>
                            </div>
                        </div>
                    </div>
                    
                </div>

                <!-- 8. Children -->
                <div class="pvp-section" id="pvp-s8">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">8</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-child"></i>
                        </div>
                        <h2>Children's Privacy</h2>
                    </div>
                    <p>
                        Our services are not directed to individuals under the age of 16.
                        We do not knowingly collect personal information from children. If
                        you are a parent or guardian and believe your child has provided
                        us with personal information, please contact us immediately.
                    </p>
                    <p>
                        Upon notification, we will promptly delete any personal
                        information collected from minors in violation of applicable law.
                    </p>
                </div>

                <!-- 9. Third-Party -->
                <div class="pvp-section" id="pvp-s9">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">9</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-globe"></i>
                        </div>
                        <h2>Third-Party Links</h2>
                    </div>
                    <p>
                        Our website may contain links to third-party websites, including
                        job boards, LinkedIn, and career resources. These sites have their
                        own privacy policies, and we are not responsible for their
                        practices.
                    </p>
                    <p>
                        We encourage you to review the privacy policy of every website you
                        visit. Inclusion of a link does not imply our endorsement of that
                        site or its privacy practices.
                    </p>
                </div>

                <!-- 10. Changes -->
                <div class="pvp-section" id="pvp-s10">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">10</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-rotate"></i>
                        </div>
                        <h2>Changes to This Policy</h2>
                    </div>
                    <p>
                        We may update this Privacy Policy from time to time. When we make
                        material changes, we will:
                    </p>
                    <ul class="pvp-list">
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Update the "Last
                https://localhost:7121/Home/Privacy#pvp-s11            Updated" date at the top of this page
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Send an email
                            notification to registered users
                        </li>
                        <li>
                            <i class="fa-solid fa-chevron-right"></i> Display a prominent
                            notice on our website for 30 days
                        </li>
                    </ul>
                    <p>
                        Your continued use of our services after any changes constitutes
                        your acceptance of the updated policy.
                    </p>
                </div>

                <!-- 11. Contact -->
                <div class="pvp-section" id="pvp-s11">
                    <div class="pvp-section-header">
                        <div class="pvp-section-num">11</div>
                        <div class="pvp-section-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <h2>Contact Us</h2>
                    </div>
                    <p>
                        If you have questions, concerns, or requests regarding this
                        Privacy Policy or your personal data, please reach out:
                    </p>
                <ul class="pvp-list">
                    <li>
                        <i class="fa-solid fa-envelope"></i>
                        <strong>Email:</strong> care@employernext.com
                    </li>
                    <li>
                        <i class="fa-solid fa-phone"></i>
                        <strong>Phone:</strong> +1 (866) 656-9514
                    </li>
                    <li>
                        <i class="fa-regular fa-clock"></i>
                        <strong>Response Time:</strong> We aim to respond within 2
                        business days
                    </li>
                </ul>
                </div>

                <!-- CTA Card -->
                <div class="pvp-cta-card">
                    <h3>Have a privacy concern?</h3>
                    <p>
                        Our team is here to help. Reach out and we'll address your
                        question or request promptly and transparently.
                    </p>
                    <div class="pvp-cta-actions">
    <a href="mailto:care@employernext.com" class="pvp-btn-blue">
        <i class="fa-regular fa-envelope"></i> Contact Privacy Team
    </a>
    <a href="/" class="pvp-btn-ghost">
        <i class="fa-solid fa-arrow-left"></i> Back to Home
    </a>
</div>
                </div>
            </main>
        </div>
    </section>
   

